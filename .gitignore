# --- Node / frontend ---------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
npm-debug.log*
