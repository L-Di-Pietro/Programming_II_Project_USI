.ipynb_checkpoints/
.python-version

# --- Build artifacts ---------------------------------------------------------
build/
dist/
*.whl

# --- Database ----------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite3

