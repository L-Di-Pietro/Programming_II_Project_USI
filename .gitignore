.idea/
*.swp
*.swo

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Project-specific --------------------------------------------------------
# Cached fetched data dumps (we use the DB, but devs sometimes export to parquet)
data_cache/
*.parquet
# Plotly HTML exports
*.html
!frontend/index.html
# Logs
logs/
*.log
# Private working/navigation docs — kept local, never committed
DOC_PROMPTS.md

# --- Frontend build artifacts that must never be committed ------------------
# frontend/src is .ts/.tsx only; any .js/.jsx/.d.ts under src/ is a tsc
# emission. vite-env.d.ts is the one legitimate .d.ts source file — keep it.
frontend/src/**/*.js
frontend/src/**/*.jsx
frontend/src/**/*.js.map
frontend/src/**/*.d.ts
frontend/src/**/*.d.ts.map
!frontend/src/vite-env.d.ts

# Stray emissions from tsconfig.node.json. With noEmit:true these should
# never appear again, but ignore them as belt-and-braces.
frontend/vite.config.js
frontend/vite.config.d.ts
